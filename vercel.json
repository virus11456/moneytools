{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,components/**,tests/**,app/**}"
    },
    "api/search.py": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,components/**,tests/**,app/**}"
    }
  },
  "headers": [
    {
      "source": "/data/daily.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/stock/:symbol",
      "destination": "/index.html"
    }
  ]
}
