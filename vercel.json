{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/data/daily.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/dashboard.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tw/broker-compare",
      "destination": "/tw/us-broker",
      "permanent": true
    },
    {
      "source": "/tw/broker-compare/",
      "destination": "/tw/us-broker",
      "permanent": true
    },
    {
      "source": "/tw/watchlist",
      "destination": "/tw/us-watchlist",
      "permanent": true
    },
    {
      "source": "/tw/watchlist/",
      "destination": "/tw/us-watchlist",
      "permanent": true
    },
    {
      "source": "/tw/risk",
      "destination": "/tw/risk-plan",
      "permanent": true
    },
    {
      "source": "/tw/risk/",
      "destination": "/tw/risk-plan",
      "permanent": true
    },
    {
      "source": "/tw/fee-calculator",
      "destination": "/tw/us-fee-calculator",
      "permanent": true
    },
    {
      "source": "/tw/fee-calculator/",
      "destination": "/tw/us-fee-calculator",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://srv1527356.hstgr.cloud/api/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "https://srv1527356.hstgr.cloud/data/:path*"
    },
    {
      "source": "/stock/:symbol",
      "destination": "/index.html"
    },
    {
      "source": "/tw",
      "destination": "/index.html"
    },
    {
      "source": "/tw/us-account",
      "destination": "/tw/us-account/index.html"
    },
    {
      "source": "/tw/us-account/",
      "destination": "/tw/us-account/index.html"
    },
    {
      "source": "/tw/watchlist-guide",
      "destination": "/tw/watchlist-guide/index.html"
    },
    {
      "source": "/tw/watchlist-guide/",
      "destination": "/tw/watchlist-guide/index.html"
    },
    {
      "source": "/tw/risk-plan",
      "destination": "/tw/risk-plan/index.html"
    },
    {
      "source": "/tw/risk-plan/",
      "destination": "/tw/risk-plan/index.html"
    },
    {
      "source": "/tw/us-vs-tw",
      "destination": "/tw/us-vs-tw/index.html"
    },
    {
      "source": "/tw/us-vs-tw/",
      "destination": "/tw/us-vs-tw/index.html"
    },
    {
      "source": "/tw/faq",
      "destination": "/tw/faq/index.html"
    },
    {
      "source": "/tw/faq/",
      "destination": "/tw/faq/index.html"
    },
    {
      "source": "/tw/us-broker",
      "destination": "/tw/us-broker/index.html"
    },
    {
      "source": "/tw/us-broker/",
      "destination": "/tw/us-broker/index.html"
    },
    {
      "source": "/tw/us-watchlist",
      "destination": "/tw/us-watchlist/index.html"
    },
    {
      "source": "/tw/us-watchlist/",
      "destination": "/tw/us-watchlist/index.html"
    },
    {
      "source": "/tw/us-fees",
      "destination": "/tw/us-fees/index.html"
    },
    {
      "source": "/tw/us-fees/",
      "destination": "/tw/us-fees/index.html"
    },
    {
      "source": "/tw/us-market-hours",
      "destination": "/tw/us-market-hours/index.html"
    },
    {
      "source": "/tw/us-market-hours/",
      "destination": "/tw/us-market-hours/index.html"
    },
    {
      "source": "/tw/us-fee-calculator",
      "destination": "/tw/us-fee-calculator/index.html"
    },
    {
      "source": "/tw/us-fee-calculator/",
      "destination": "/tw/us-fee-calculator/index.html"
    },
    {
      "source": "/tw/:path*",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "batch/condition-progress": false
    }
  }
}
